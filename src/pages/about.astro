---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>About</h1>
      <p>
        I work on static recompilation and low-level debugging, mainly around Xbox
        binaries. This site is where I keep the traces, dead ends, and fixes from
        that work. Code is at
        <a href="https://github.com/sigods/otogi1">github.com/sigods/otogi1</a>.
      </p>
    </main>
    <Footer />
  </body>
</html>
